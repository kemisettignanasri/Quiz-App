<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_background"
        app:title="@string/app_name"
        app:titleTextColor="@color/white">

        <Button
            android:id="@+id/signOutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="Sign Out"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/home_button" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:cardCornerRadius="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    android:text="Select a subject"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:text="Start your coding journey"/>
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:src="@drawable/splash_image"/>


        </LinearLayout>

    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/card_view_design"
        android:layout_marginTop="25dp">

        <ScrollView
            android:layout_marginTop="35dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/javaCard"
                        android:onClick="java"
                        android:layout_marginEnd="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:id="@+id/javaImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/java" />

                            <TextView
                                android:id="@+id/javaText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JAVA"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/kotlinCard"
                        android:onClick="kotlin"
                        android:layout_marginStart="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/kotlinImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/kotlin"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KOTLIN"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>


                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/pythonCard"
                        android:onClick="python"
                        android:layout_marginEnd="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/pythonImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/python"/>

                            <TextView
                                android:id="@+id/pythonText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PYTHON"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cppCard"
                        android:onClick="cpp"
                        android:layout_marginStart="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/cppImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/cpp"/>

                            <TextView
                                android:id="@+id/cppText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="C++"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>


                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/dartCard"
                        android:onClick="dart"
                        android:layout_marginEnd="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/dartImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/dart"/>

                            <TextView
                                android:id="@+id/dartText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DART"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/sql"
                        android:onClick="sql"
                        android:layout_marginStart="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/sqlImage"
                                android:layout_marginTop="10dp"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:src="@drawable/sql"/>

                            <TextView
                                android:id="@+id/sqlText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SQL"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>


                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="25dp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/xmlCard"
                        android:onClick="xml"
                        android:layout_marginEnd="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/xmlImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/xml"/>

                            <TextView
                                android:id="@+id/xmlTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="XML"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cCard"
                        android:onClick="c"
                        android:layout_marginStart="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        app:cardCornerRadius="10dp"
                        android:backgroundTint="@color/card_background"
                        android:layout_weight="1"
                        tools:ignore="OnClick">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/cImage"
                                android:layout_marginTop="20dp"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:src="@drawable/c"/>

                            <TextView
                                android:id="@+id/cText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="C Language"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="20sp"/>
                        </LinearLayout>


                    </androidx.cardview.widget.CardView>


                </LinearLayout>

            </LinearLayout>


        </ScrollView>
    </LinearLayout>

</LinearLayout>
